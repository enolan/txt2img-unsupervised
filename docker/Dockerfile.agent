FROM nvidia/cuda:13.1.1-runtime-ubuntu24.04

# Without a UTF-8 locale the terminal defaults to POSIX/ASCII, which mangles the Unicode box-drawing
# Claude Code and friends render. C.UTF-8 is built into glibc, so no locales package is needed.
ENV LANG=C.UTF-8

# Restore man pages and docs stripped by Ubuntu's minimized image
RUN yes | unminimize

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl fish git gnupg jq less lnav man-db htop psmisc tmux \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 LTS for Codex CLI
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# GitHub CLI, so agents can open pull requests as the repository's GitHub App
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Codex CLI
RUN npm install -g @openai/codex

# Non-root user with configurable UID for host file permission compatibility
ARG USER_UID=1000
RUN userdel -r ubuntu 2>/dev/null; \
    useradd -m -s /usr/bin/fish -u ${USER_UID} devuser \
    && mkdir -p /run/user/${USER_UID} \
    && chown devuser:devuser /run/user/${USER_UID}
ENV XDG_RUNTIME_DIR=/run/user/${USER_UID}

USER devuser
ENV PATH="/home/devuser/.local/bin:${PATH}"

# launch-agent-container.sh mounts a gh shim in here. Create the directory as devuser so the mount
# doesn't create it as root, which would leave it unwritable for the agent installs below.
RUN mkdir -p /home/devuser/.local/bin

# Install agents as user so they can be autoupdated.
# Claude Code
RUN curl -fsSL https://claude.ai/install.sh | bash

# Pre-install project Python so uv sync doesn't have to download it
ARG PYTHON_VERSION=3.11.14
RUN uv python install ${PYTHON_VERSION}
WORKDIR /home/devuser/txt2img-unsupervised
CMD ["fish"]
